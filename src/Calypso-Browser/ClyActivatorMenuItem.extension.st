Extension { #name : 'ClyActivatorMenuItem' }

{ #category : '*Calypso-Browser' }
ClyActivatorMenuItem >> buildBrowserNotebookActions [

	^ self activator buildBrowserNotebookActions
]

{ #category : '*Calypso-Browser' }
ClyActivatorMenuItem >> buildBrowserToolbar: toolbarMorph [

	self activator buildBrowserToolbar: toolbarMorph
]
